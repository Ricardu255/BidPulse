# BidPulse 环境变量模板
#
# Spring Boot 不会自动加载 .env；请用 shell export、IDE 运行配置或容器 secret 注入。
# 本文件只列字段，不包含任何真实值；不要把真实密钥写进来后提交。
#
# 本地 demo 可以全部留空，应用会使用 application.yml 的默认值。
# prod profile 下 BIDPULSE_AUTH_SECRET / BIDPULSE_DB_PASSWORD / 各账号密码缺失会直接启动失败。

# --- MySQL ---
BIDPULSE_JDBC_URL='jdbc:mysql://127.0.0.1:3306/bidpulse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&socketTimeout=3000&connectTimeout=3000'
BIDPULSE_DB_USERNAME=root
BIDPULSE_DB_PASSWORD=

# --- Redis ---
BIDPULSE_REDIS_HOST=127.0.0.1
BIDPULSE_REDIS_PORT=6379
BIDPULSE_REDIS_DATABASE=0

# --- Kafka ---
BIDPULSE_KAFKA_BOOTSTRAP=127.0.0.1:9092
BIDPULSE_KAFKA_TOPIC=bid_event
BIDPULSE_KAFKA_DLT_TOPIC=bid_event.DLT
# 单节点 demo 保持 1；生产多 broker 设 3（自动设置 min.insync.replicas=2）
BIDPULSE_KAFKA_REPLICAS=1

# --- HTTP / Actuator ---
BIDPULSE_SERVER_ADDRESS=127.0.0.1
BIDPULSE_HEALTH_DETAILS=when-authorized

# --- 控制台只读连接池（可选，默认值即可）---
BIDPULSE_CONSOLE_READ_MAX_POOL_SIZE=4
BIDPULSE_CONSOLE_READ_MIN_IDLE=1
BIDPULSE_CONSOLE_READ_CONNECT_TIMEOUT_MS=3000
BIDPULSE_CONSOLE_READ_QUERY_TIMEOUT_SECONDS=2

# --- Auth（prod 必填；本地留空会生成一次性随机密码并打印到日志）---
BIDPULSE_AUTH_SECRET=
BIDPULSE_ADMIN_PASSWORD=
BIDPULSE_OPERATOR_PASSWORD=
BIDPULSE_VIEWER_PASSWORD=

# --- 集成测试专用（见 README「测试与 CI」）---
# BIDPULSE_IT=true
# BIDPULSE_JDBC_URL='jdbc:mysql://127.0.0.1:3306/bidpulse_it?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&socketTimeout=3000&connectTimeout=3000'
# BIDPULSE_REDIS_DATABASE=1
# BIDPULSE_KAFKA_TOPIC=bidpulse_it_bid_event
# BIDPULSE_KAFKA_DLT_TOPIC=bidpulse_it_bid_event.DLT
