{
  "name": "bidpulse-console-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc --noEmit && vite build",
    "build:embedded": "vue-tsc --noEmit && vite build --outDir ../src/main/resources/static/console --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "element-plus": "^2.8.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
