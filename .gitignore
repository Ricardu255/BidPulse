# 忽略所有文件夹
/*/

# 但是下面这几个文件夹，不要忽略（保留纳入git）
!/sql/
!/src/
!/tools/
!/console-ui/
!/docs/
# .github 必须放行，否则 CI workflow（ci.yml）推不上 GitHub、永不触发
!/.github/

# 前端依赖与构建产物
console-ui/node_modules/
console-ui/dist/
console-ui/screenshots/
console-ui/.taste-skill/
console-ui/test-results/
console-ui/playwright-report/
src/main/resources/static/console/

# 编译产物：必须忽略。旧配置里写成 !/target/ 把 .class 全部放行进了仓库
/target/

# 本地文档与图片，不上传
/docs/local/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
!docs/images/*.png

# 本地环境变量与密钥：只保留模板
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.jks
application-local.yml
application-*.local.yml
/secrets/
/var/

# 本地日志
*.log
