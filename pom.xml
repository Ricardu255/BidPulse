<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.bidpulse</groupId>
  <artifactId>bidpulse-engine</artifactId>
  <version>0.1.0-M0</version>
  <name>BidPulse</name>
  <description>BidPulse · 高性能实时竞价广告投放引擎</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      集成测试分层：BidFlowTest / BudgetServiceTest 真连 MySQL + Redis + Kafka，
      打 @Tag("integration")。默认 mvn test 只跑 37 个纯单测（168 个用例），没有中间件也能全绿；
      跑全量用 profile（不要用 -Dsurefire.excludedGroups=...：Windows PowerShell 调 mvn.cmd 时
      带点的 -D 参数会在第一个点处被拆开，Maven 会报 "Unknown lifecycle phase '.excludedGroups=none'"）：
        mvn test -Pfull-tests
    -->
    <surefire.excludedGroups>integration</surefire.excludedGroups>
    <!--
      传给测试 JVM 的「全量模式」标记。IntegrationTestGuard 用它区分两种情况：
        · 普通 mvn test：tag 已排除，守卫根本不会执行；
        · mvn test -Pfull-tests 但忘了设置 BIDPULSE_IT=true：直接失败，
          而不是静默跳过所有集成测试、制造「全绿」假象。
    -->
    <bidpulse.full-tests>false</bidpulse.full-tests>
  </properties>

  <dependencies>
    <!-- Web：竞价接口与管理端 REST 接口 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Security：控制台/管理端登录、角色权限与统一 401/403 响应 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Bean Validation：@Valid 入参校验（Spring Boot 3 起 Web starter 不再自带） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Actuator：健康检查与 P99 埋点指标出口 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Prometheus 指标注册表：没有它，management.endpoints.exposure 里的 prometheus 端点
         只是一个不存在的名字（/actuator/prometheus 会 404）。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Redis：预算余额与 Lua 原子扣减 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- Lettuce 连接池：spring.data.redis.lettuce.pool 的配置只有在类路径存在
         commons-pool2 时才会生效；缺它时 Spring Boot 会静默忽略池化参数。 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>

    <!-- MyBatis：手写 SQL，不用 JPA（要展示 SQL 控制力） -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>3.0.3</version>
    </dependency>

    <!-- MySQL 驱动 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Kafka：竞价事件旁路（M6 启用，此处先引入依赖） -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!--
      Sentinel 核心：熔断降级（M8 替换自写的 CircuitBreaker）。
      只引 core —— 规则全部在代码内定义：
        · 不引 sentinel-transport-* / dashboard 客户端 → 不启控制台、不占端口、无多余进程
        · 控制台改的规则默认不持久化（重启即还原），代码内定义反而更可靠
      选 SphU 原生 API 而非 @SentinelResource 注解：
        · 不需要 AspectJ 织入，不动 Spring 代理结构，改造风险最低
        · 熔断粒度能落在「依赖」上（DB 一个资源、Redis 一个资源），而不是整个接口
    -->
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-core</artifactId>
      <version>1.8.6</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ArchUnit：把分层约定变成可执行测试（热路径不依赖控制台、controller 不碰 SQL 等） -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        构建环境门禁：版本不对或 pom 出现重复依赖声明时直接失败，
        而不是等到运行期才暴露「本机 JDK 不对」。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.8,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        覆盖率度量：prepare-agent 把 JaCoCo agent 挂到 surefire 的测试 JVM 上；
        report 在 verify 阶段生成 target/site/jacoco/（HTML + XML + CSV）。
        check 门禁在拿到真实基线后再收紧（见下方 execution）。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!--
            覆盖率门禁。阈值按「全量测试」的真实基线设定（2026-11-05）：
            整体行 70.8% / 分支 20.8%，核心包 bid 73.9%、infra.redis 81.3%、infra.kafka 86.4%。
            门禁比基线低 2–7 个百分点，防止小幅波动误伤，但能挡住明显退化。
            分支覆盖率是「地板」而不是目标：当前大量分支在错误路径上，先防止继续下滑。
            只在 verify 阶段生效；CI 用 `mvn verify -Pfull-tests`，单跑 `mvn test` 不触发。
          -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.68</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.18</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.bidpulse.bid</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.bidpulse.infra.redis</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.bidpulse.infra.kafka</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        静态缺陷扫描：只拦 High 级别（空指针、资源泄漏、并发误用等），
        避免把大量 Spring/Lombok 风格的误报变成噪音。effort=Max 提高分析深度。
        报告输出 target/spotbugsXml.xml，CI 失败时作为 artifact 上传。
      -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.8.6.4</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <failOnError>true</failOnError>
          <!-- 只排除 Spring/DTO 的系统性误报与「故意在构造期失败」的启动守卫，见文件内说明 -->
          <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 由 pom 属性驱动：默认排除 integration，-Pfull-tests 时置为 none（不排除任何 tag） -->
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          <!-- 测试 JVM 固定东八区：预算日 key/频次小时 key/概览今日窗口都依赖本地时区，
               不能让开发者本机与 CI 的时区差异影响断言。
               @{argLine} 是 JaCoCo prepare-agent 注入的 agent 参数；不写它，
               显式 argLine 会把 agent 覆盖掉，覆盖率报告永远是空的。 -->
          <argLine>@{argLine} -Duser.timezone=Asia/Shanghai</argLine>
          <systemPropertyVariables>
            <!-- 让 IntegrationTestGuard 知道当前是否显式要求跑全量 -->
            <bidpulse.full-tests>${bidpulse.full-tests}</bidpulse.full-tests>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      全量测试（含 @Tag("integration") 的真连中间件用例）。
      用 profile 而不是 -Dsurefire.excludedGroups=none：后者在 Windows 上由 PowerShell 调用
      mvn.cmd 时会被拆成两个参数（-Dsurefire / .excludedGroups=none），Maven 直接报
      "Unknown lifecycle phase"。
        mvn test -Pfull-tests
    -->
    <profile>
      <id>full-tests</id>
      <properties>
        <!-- "none" 不是任何测试的 tag，等价于不排除任何分组 -->
        <surefire.excludedGroups>none</surefire.excludedGroups>
        <bidpulse.full-tests>true</bidpulse.full-tests>
      </properties>
    </profile>
  </profiles>
</project>
