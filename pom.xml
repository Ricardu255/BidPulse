<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.bidpulse</groupId>
  <artifactId>bidpulse-engine</artifactId>
  <version>0.1.0-M0</version>
  <name>BidPulse</name>
  <description>BidPulse · 高性能实时竞价广告投放引擎</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      集成测试分层：BidFlowTest / BudgetServiceTest 真连 MySQL + Redis + Kafka，
      打 @Tag("integration")。默认 mvn test 只跑 8 个纯单测（29 个用例），没有中间件也能全绿；
      跑全量用 profile（不要用 -Dsurefire.excludedGroups=...：Windows PowerShell 调 mvn.cmd 时
      带点的 -D 参数会在第一个点处被拆开，Maven 会报 "Unknown lifecycle phase '.excludedGroups=none'"）：
        mvn test -Pfull-tests
    -->
    <surefire.excludedGroups>integration</surefire.excludedGroups>
  </properties>

  <dependencies>
    <!-- Web：竞价接口与管理端 REST 接口 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation：@Valid 入参校验（Spring Boot 3 起 Web starter 不再自带） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Actuator：健康检查与 P99 埋点指标出口 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Prometheus 指标注册表：没有它，management.endpoints.exposure 里的 prometheus 端点
         只是一个不存在的名字（/actuator/prometheus 会 404）。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Redis：预算余额与 Lua 原子扣减 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- Lettuce 连接池：spring.data.redis.lettuce.pool 的配置只有在类路径存在
         commons-pool2 时才会生效；缺它时 Spring Boot 会静默忽略池化参数。 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>

    <!-- MyBatis：手写 SQL，不用 JPA（要展示 SQL 控制力） -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>3.0.3</version>
    </dependency>

    <!-- MySQL 驱动 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Kafka：竞价事件旁路（M6 启用，此处先引入依赖） -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!--
      Sentinel 核心：熔断降级（M8 替换自写的 CircuitBreaker）。
      只引 core —— 规则全部在代码内定义：
        · 不引 sentinel-transport-* / dashboard 客户端 → 不启控制台、不占端口、无多余进程
        · 控制台改的规则默认不持久化（重启即还原），代码内定义反而更可靠
      选 SphU 原生 API 而非 @SentinelResource 注解：
        · 不需要 AspectJ 织入，不动 Spring 代理结构，改造风险最低
        · 熔断粒度能落在「依赖」上（DB 一个资源、Redis 一个资源），而不是整个接口
    -->
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-core</artifactId>
      <version>1.8.6</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 由 pom 属性驱动：默认排除 integration，-Pfull-tests 时置为 none（不排除任何 tag） -->
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      全量测试（含 @Tag("integration") 的真连中间件用例）。
      用 profile 而不是 -Dsurefire.excludedGroups=none：后者在 Windows 上由 PowerShell 调用
      mvn.cmd 时会被拆成两个参数（-Dsurefire / .excludedGroups=none），Maven 直接报
      "Unknown lifecycle phase"。
        mvn test -Pfull-tests
    -->
    <profile>
      <id>full-tests</id>
      <properties>
        <!-- "none" 不是任何测试的 tag，等价于不排除任何分组 -->
        <surefire.excludedGroups>none</surefire.excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
